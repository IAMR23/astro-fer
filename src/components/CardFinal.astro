---
import MusicPlayer from "./MusicPlayer.astro";

const { nombre = "", pases = "" } = Astro.props;

const mapUrl = "https://www.google.com/maps/place/Quinta+El+Guabo/@-0.1814147,-78.3959473,17z/data=!3m1!4b1!4m6!3m5!1s0x91d5919cc2f08ac5:0xd042fa4002fa8bc3!8m2!3d-0.1814147!4d-78.3959473!16s%2Fg%2F11b724qsp7";
const rsvpUrl = "https://moonlit-begonia-f9fbcd.netlify.app/";

const gallery = [
  { src: "/pexels-begum-bodur-49915278-34274513-640.webp", srcset: "/pexels-begum-bodur-49915278-34274513-640.webp 640w, /pexels-begum-bodur-49915278-34274513-1200.webp 1200w", full: "/pexels-begum-bodur-49915278-34274513.jpg", width: 640, height: 1138, alt: "Ramo de flores blancas" },
  { src: "/pexels-adeniuso-gomes-2148096772-30679828-640.webp", srcset: "/pexels-adeniuso-gomes-2148096772-30679828-640.webp 640w, /pexels-adeniuso-gomes-2148096772-30679828-1200.webp 1200w", full: "/pexels-adeniuso-gomes-2148096772-30679828.jpg", width: 640, height: 960, alt: "Las manos de los novios con sus anillos" },
  { src: "/pexels-dulce-panebra-695494914-38675490-640.webp", srcset: "/pexels-dulce-panebra-695494914-38675490-640.webp 640w, /pexels-dulce-panebra-695494914-38675490-1200.webp 1200w", full: "/pexels-dulce-panebra-695494914-38675490.jpg", width: 640, height: 1064, alt: "Lizbeth y Fernando sonriendo" },
  { src: "/pexels-dulce-panebra-695494914-38675502-640.webp", srcset: "/pexels-dulce-panebra-695494914-38675502-640.webp 640w, /pexels-dulce-panebra-695494914-38675502-1200.webp 1200w", full: "/pexels-dulce-panebra-695494914-38675502.jpg", width: 640, height: 1140, alt: "Lizbeth y Fernando caminando entre árboles" },
  { src: "/pexels-dulce-panebra-695494914-38675491-640.webp", srcset: "/pexels-dulce-panebra-695494914-38675491-640.webp 640w, /pexels-dulce-panebra-695494914-38675491-1200.webp 1200w", full: "/pexels-dulce-panebra-695494914-38675491.jpg", width: 640, height: 1098, alt: "Fernando cargando a Lizbeth" },
];
---

<main class="invitation-shell">
  <nav class="topbar" aria-label="Navegación principal">
    <a href="#inicio">Inicio</a>
    <a href="#historia">Nuestra historia</a>
    <a href="#itinerario">El día</a>
    <a class="monogram" href="#inicio" aria-label="Lizbeth y Fernando, inicio"><span>L</span><i>&amp;</i><span>F</span></a>
    <a href="#lugar">Lugar</a>
    <a href="#galeria">Galería</a>
    <a href="#confirmar">Confirmar</a>
  </nav>

  <div class="music-dock"><MusicPlayer /></div>

  <section class="hero celestial" id="inicio">
    <div class="hero-copy reveal">
      {nombre && <p class="guest-name">{nombre}</p>}
      <p class="eyebrow">Nos casamos</p>
      <h1><span>Lizbeth</span><em>y</em><span>Fernando</span></h1>
      <div class="ornament" aria-hidden="true"><span></span>✦<span></span></div>
      <p class="date">Sábado · 18 de septiembre · 2027</p>
      <p class="place">Quito, Ecuador</p>
    </div>
    <div class="hero-photo-wrap reveal">
      <div class="hero-photo"><img src="/pexels-dulce-panebra-695494914-38675490-640.webp" srcset="/pexels-dulce-panebra-695494914-38675490-640.webp 640w, /pexels-dulce-panebra-695494914-38675490-1200.webp 1200w" sizes="(max-width: 760px) 88vw, 390px" alt="Lizbeth y Fernando celebrando juntos" width="640" height="1064" fetchpriority="high" decoding="async" /></div>
    </div>
    <span class="moon-mark" aria-hidden="true">☾</span>
    <span class="spark spark-one" aria-hidden="true">✦</span>
    <span class="spark spark-two" aria-hidden="true">✧</span>
  </section>

  <section class="countdown section-line" aria-labelledby="countdown-title" data-countdown="2027-09-18T16:30:00-05:00">
    <div class="sun-mark" aria-hidden="true">☼</div>
    <div class="countdown-content">
      <p class="section-kicker" id="countdown-title"><span>✦</span> Cuenta regresiva para nuestro gran día <span>✦</span></p>
      <div class="countdown-grid" aria-live="polite">
        <div><strong data-days>--</strong><span>Días</span></div>
        <div><strong data-hours>--</strong><span>Horas</span></div>
        <div><strong data-minutes>--</strong><span>Minutos</span></div>
        <div><strong data-seconds>--</strong><span>Segundos</span></div>
      </div>
    </div>
    <div class="moon-sun" aria-hidden="true">☽</div>
  </section>

  <section class="story section-line" id="historia">
    <div class="story-copy reveal">
      <p class="section-kicker">✦ Nuestra historia ✦</p>
      <h2>El comienzo de nuestro para siempre</h2>
      <p>Coincidimos sin imaginar que aquel momento cambiaría nuestra vida. Entre viajes, risas y sueños compartidos encontramos un hogar el uno en el otro.</p>
      <p class="script-line">Y lo mejor está por comenzar.</p>
    </div>
    <div class="story-gallery reveal">
      <figure class="arch-photo tall"><img src="/pexels-dulce-panebra-695494914-38675502-640.webp" srcset="/pexels-dulce-panebra-695494914-38675502-640.webp 640w, /pexels-dulce-panebra-695494914-38675502-1200.webp 1200w" sizes="(max-width: 760px) 33vw, 220px" width="640" height="1140" alt="Lizbeth y Fernando caminando entre árboles" loading="lazy" decoding="async" /></figure>
      <figure class="arch-photo short"><img src="/pexels-adeniuso-gomes-2148096772-30679828-640.webp" srcset="/pexels-adeniuso-gomes-2148096772-30679828-640.webp 640w, /pexels-adeniuso-gomes-2148096772-30679828-1200.webp 1200w" sizes="(max-width: 760px) 33vw, 220px" width="640" height="960" alt="Los anillos de la pareja" loading="lazy" decoding="async" /></figure>
      <figure class="arch-photo tall"><img src="/pexels-dulce-panebra-695494914-38675491-640.webp" srcset="/pexels-dulce-panebra-695494914-38675491-640.webp 640w, /pexels-dulce-panebra-695494914-38675491-1200.webp 1200w" sizes="(max-width: 760px) 33vw, 220px" width="640" height="1098" alt="Fernando carga a Lizbeth" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="day-venue section-line" id="itinerario">
    <div class="schedule reveal">
      <p class="section-kicker light">El día</p>
      <div class="schedule-list">
        <div class="schedule-item"><img src="/anillo2.png" alt="" /><span class="time">4:30 pm</span><span>Ceremonia</span></div>
        <div class="schedule-item"><img src="/copas.png" alt="" /><span class="time">5:30 pm</span><span>Cóctel de bienvenida</span></div>
        <div class="schedule-item"><span class="line-icon" aria-hidden="true">♢</span><span class="time">7:00 pm</span><span>Cena y brindis</span></div>
        <div class="schedule-item"><span class="line-icon" aria-hidden="true">♫</span><span class="time">9:00 pm</span><span>Baile bajo las estrellas</span></div>
      </div>
    </div>
    <div class="venue reveal" id="lugar">
      <p class="section-kicker">El lugar</p>
      <div class="venue-sketch" aria-hidden="true"><span>♜</span><span>♜</span><strong>⌂</strong><span>♜</span><span>♜</span></div>
      <h2>Quinta El Guabo</h2>
      <p>Un rincón especial en Quito, Ecuador</p>
      <a class="outline-button" href={mapUrl} target="_blank" rel="noreferrer">Ver ubicación <span>→</span></a>
    </div>
  </section>

  <section class="details celestial section-line">
    <div class="dress reveal">
      <p class="section-kicker light">Código de vestimenta</p>
      <div class="dress-icons"><img src="/vestido.png" alt="Vestido formal" /><img src="/terno.png" alt="Traje formal" /></div>
      <p>Formal</p>
      <small>Evitar blanco, crema, beige y rojo.</small>
    </div>
    <div class="palette reveal">
      <p class="section-kicker light">Nuestra paleta</p>
      <div class="swatches" aria-label="Paleta sugerida">
        <span style="--swatch:#b7a3c7"><i>Lila</i></span>
        <span style="--swatch:#8e96aa"><i>Azul niebla</i></span>
        <span style="--swatch:#c5c4c2"><i>Plata</i></span>
        <span style="--swatch:#e5cad0"><i>Rosa</i></span>
        <span style="--swatch:#eee6d7"><i>Marfil</i></span>
      </div>
    </div>
    <blockquote class="reveal">“Un cielo lleno de estrellas,<br />una noche llena de amor.”</blockquote>
  </section>

  <section class="gallery-section section-line" id="galeria">
    <p class="section-kicker">✦ Algunos de nuestros momentos favoritos ✦</p>
    <div class="photo-strip">
      {gallery.map((photo) => (
        <a href={photo.full} target="_blank" aria-label={`Abrir fotografía: ${photo.alt}`}><img src={photo.src} srcset={photo.srcset} sizes="(max-width: 760px) 33vw, 185px" width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" /></a>
      ))}
    </div>
    <a class="outline-button" href="#historia">Nuestra historia <span>↑</span></a>
  </section>

  <section class="rsvp celestial section-line" id="confirmar">
    <div class="rsvp-photo reveal"><img src="/main_photo.webp" alt="Silueta de una pareja mirándose" loading="lazy" /></div>
    <div class="rsvp-copy reveal">
      <p class="section-kicker light">✦ Celebra con nosotros ✦</p>
      <h2>Acompáñanos</h2>
      <p>Confirma tu asistencia antes del<br /><strong>18 de agosto de 2027</strong></p>
      <p class="small-copy">No podemos esperar para celebrar contigo.</p>
      <a class="light-button" href={rsvpUrl} target="_blank" rel="noreferrer">Confirmar asistencia <span>→</span></a>
    </div>
  </section>

  {pases && (
    <section class="personal-pass section-line">
      <span aria-hidden="true">✦</span>
      <p>Hemos reservado</p>
      <strong>{pases} {pases === "1" ? "lugar" : "lugares"}</strong>
      <p>especialmente para ti.</p>
      <small>Esta invitación es personal e intransferible.</small>
    </section>
  )}

  <footer>
    <div class="footer-moon" aria-hidden="true">☾</div>
    <div>
      <h2>Lizbeth <i>&amp;</i> Fernando</h2>
      <p>18 · 09 · 2027 &nbsp; | &nbsp; Quito, Ecuador</p>
      <small>Nos encantará compartir este día contigo.</small>
    </div>
    <a href="#inicio" aria-label="Volver arriba">↑</a>
  </footer>
  <div class="copyright">© 2027 Lizbeth &amp; Fernando · Hecho con amor bajo las estrellas</div>
</main>

<script>
  const countdown = document.querySelector<HTMLElement>("[data-countdown]");
  if (countdown) {
    const target = new Date(countdown.dataset.countdown ?? "").getTime();
    const values = {
      days: countdown.querySelector<HTMLElement>("[data-days]"),
      hours: countdown.querySelector<HTMLElement>("[data-hours]"),
      minutes: countdown.querySelector<HTMLElement>("[data-minutes]"),
      seconds: countdown.querySelector<HTMLElement>("[data-seconds]"),
    };
    const update = () => {
      const distance = Math.max(0, target - Date.now());
      const days = Math.floor(distance / 86400000);
      const hours = Math.floor((distance % 86400000) / 3600000);
      const minutes = Math.floor((distance % 3600000) / 60000);
      const seconds = Math.floor((distance % 60000) / 1000);
      if (values.days) values.days.textContent = String(days).padStart(2, "0");
      if (values.hours) values.hours.textContent = String(hours).padStart(2, "0");
      if (values.minutes) values.minutes.textContent = String(minutes).padStart(2, "0");
      if (values.seconds) values.seconds.textContent = String(seconds).padStart(2, "0");
    };
    update();
    window.setInterval(update, 1000);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.14 });
  document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
</script>

<style>
  .invitation-shell { width:min(100%,1180px); margin:0 auto; overflow:hidden; background:var(--paper); box-shadow:0 0 60px rgba(35,35,48,.18); }
  .section-line { border-top:1px solid var(--line); }
  .topbar { position:relative; z-index:20; min-height:76px; display:grid; grid-template-columns:repeat(3,1fr) 96px repeat(3,1fr); align-items:center; gap:8px; padding:0 42px; background:var(--paper); }
  .topbar > a:not(.monogram) { text-align:center; text-decoration:none; text-transform:uppercase; letter-spacing:.13em; font-size:.63rem; font-weight:500; transition:color .2s ease; }
  .topbar > a:not(.monogram):hover { color:#89749b; }
  .monogram { align-self:start; justify-self:center; width:74px; height:96px; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1px solid var(--line); border-top:0; background:var(--paper); text-decoration:none; font-family:"Italiana",serif; font-size:1.15rem; line-height:.7; box-shadow:0 6px 20px rgba(60,55,65,.08); }
  .monogram i { font-size:.7rem; color:var(--gold); }
  .music-dock { position:fixed; z-index:30; right:24px; bottom:24px; width:min(360px,calc(100vw - 48px)); }
  .celestial { background-color:var(--navy); background-image:radial-gradient(circle at 12% 18%,rgba(255,255,255,.8) 0 1px,transparent 1.8px),radial-gradient(circle at 76% 24%,rgba(255,255,255,.65) 0 1px,transparent 1.7px),linear-gradient(132deg,#626780 0%,#8c86a6 56%,#565c78 100%); background-size:88px 88px,122px 122px,auto; }
  .hero { position:relative; min-height:600px; display:grid; grid-template-columns:1.05fr .95fr; align-items:center; gap:44px; padding:68px 88px 58px; color:var(--paper); }
  .hero::after,.rsvp::after,.details::after { content:""; position:absolute; inset:0; opacity:.16; pointer-events:none; background:url("/og-background.webp") center/cover; mix-blend-mode:screen; }
  .hero-copy,.hero-photo-wrap,.moon-mark,.spark,.rsvp > *,.details > * { position:relative; z-index:2; }
  .hero-copy { text-align:center; }
  .guest-name { display:inline-block; margin:0 0 24px; padding:8px 20px; border:1px solid rgba(245,240,232,.55); border-radius:999px; font-family:"Cormorant Garamond",serif; font-size:1.05rem; font-style:italic; }
  .eyebrow,.date,.place,.section-kicker { margin:0; text-transform:uppercase; letter-spacing:.24em; font-size:.67rem; font-weight:500; }
  h1 { margin:18px 0 18px; font-family:"Italiana",serif; font-size:clamp(3.65rem,6vw,6.2rem); font-weight:400; line-height:.88; text-transform:uppercase; }
  h1 span { display:block; }
  h1 em { display:block; margin:8px 0 4px; font-family:"Cormorant Garamond",serif; font-size:.42em; font-weight:400; text-transform:lowercase; }
  .ornament { display:flex; align-items:center; justify-content:center; gap:10px; margin:0 auto 18px; color:#ecd89e; font-size:.7rem; }
  .ornament span { width:50px; height:1px; background:currentColor; }
  .place { margin-top:10px; font-size:.57rem; }
  .hero-photo-wrap { width:min(100%,390px); justify-self:center; padding:14px; border:1px solid rgba(245,240,232,.75); border-radius:195px 195px 0 0; }
  .hero-photo { height:465px; overflow:hidden; border-radius:180px 180px 0 0; box-shadow:0 22px 45px rgba(31,32,52,.28); }
  .hero-photo img { width:100%; height:100%; object-fit:cover; object-position:50% 52%; }
  .moon-mark { position:absolute; left:7%; top:31%; font-size:4.6rem; color:#e5d8bd; transform:rotate(-18deg); }
  .spark { position:absolute; color:#f6e3a8; }
  .spark-one { top:14%; right:5%; font-size:3.2rem; }
  .spark-two { bottom:16%; left:43%; font-size:2.1rem; }
  .countdown { min-height:188px; display:grid; grid-template-columns:150px 1fr 150px; align-items:center; padding:30px 54px; text-align:center; background:var(--paper); }
  .sun-mark,.moon-sun { font-family:"Cormorant Garamond",serif; font-size:5.8rem; color:#afa4ad; }
  .moon-sun { transform:rotate(22deg); }
  .countdown-content { width:min(100%,670px); justify-self:center; }
  .countdown-content .section-kicker { margin-bottom:24px; }
  .countdown-content .section-kicker span { color:var(--gold); }
  .countdown-grid { display:grid; grid-template-columns:repeat(4,1fr); }
  .countdown-grid div { display:flex; flex-direction:column; gap:3px; padding:0 20px; border-right:1px solid var(--line); }
  .countdown-grid div:last-child { border:0; }
  .countdown-grid strong { font-family:"Cormorant Garamond",serif; font-size:2.7rem; font-weight:400; line-height:1; }
  .countdown-grid span { text-transform:uppercase; letter-spacing:.18em; font-size:.55rem; }
  .story { display:grid; grid-template-columns:.82fr 1.18fr; align-items:center; gap:50px; padding:54px 64px; background:var(--paper); }
  .story-copy { text-align:center; }
  .story h2,.venue h2,.rsvp h2,footer h2 { margin:17px 0; font-family:"Cormorant Garamond",serif; font-size:2.5rem; font-weight:500; line-height:1; }
  .story-copy > p:not(.section-kicker,.script-line) { max-width:430px; margin:20px auto; font-family:"Cormorant Garamond",serif; font-size:1.08rem; line-height:1.7; }
  .script-line { margin:22px 0 0; color:#8b7895; font-family:"Cormorant Garamond",serif; font-size:1.45rem; font-style:italic; }
  .story-gallery { min-height:330px; display:grid; grid-template-columns:repeat(3,1fr); align-items:end; gap:16px; }
  .arch-photo { height:280px; margin:0; overflow:hidden; border:1px solid #fff; border-radius:110px 110px 0 0; box-shadow:0 9px 22px rgba(47,47,56,.11); }
  .arch-photo.tall { height:330px; }
  .arch-photo img { width:100%; height:100%; object-fit:cover; }
  .arch-photo:nth-child(1) img { object-position:50% 78%; }
  .arch-photo:nth-child(2) img { object-position:52% 50%; }
  .day-venue { display:grid; grid-template-columns:1fr 1fr; min-height:410px; }
  .schedule,.venue { padding:48px 70px; }
  .schedule { color:var(--paper); background:linear-gradient(140deg,#a899bd,#c8bdd2); }
  .section-kicker.light { color:var(--paper); }
  .schedule .section-kicker,.venue .section-kicker { margin-bottom:30px; text-align:center; font-family:"Cormorant Garamond",serif; font-size:1.45rem; letter-spacing:.1em; }
  .schedule-list { max-width:350px; margin:0 auto; }
  .schedule-item { min-height:66px; display:grid; grid-template-columns:40px 76px 1fr; align-items:center; gap:12px; border-bottom:1px solid rgba(255,255,255,.27); text-transform:uppercase; letter-spacing:.08em; font-size:.61rem; }
  .schedule-item:last-child { border:0; }
  .schedule-item img { width:26px; height:26px; object-fit:contain; filter:grayscale(1) brightness(2); opacity:.75; }
  .line-icon { font-family:"Cormorant Garamond",serif; font-size:1.8rem; opacity:.7; }
  .schedule-item .time { font-weight:500; }
  .venue { display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; background:var(--paper); }
  .venue-sketch { width:100%; display:flex; align-items:end; justify-content:center; gap:18px; margin:-8px 0 6px; color:#898897; font-family:serif; font-size:2.2rem; opacity:.65; border-bottom:1px solid var(--line); }
  .venue-sketch strong { font-size:4.7rem; font-weight:400; line-height:.8; }
  .venue h2 { margin:10px 0 6px; }
  .venue > p:not(.section-kicker) { margin:0 0 22px; font-family:"Cormorant Garamond",serif; font-size:1rem; }
  .outline-button,.light-button { min-height:38px; display:inline-flex; align-items:center; justify-content:center; gap:24px; padding:8px 24px; border:1px solid currentColor; border-radius:999px; text-decoration:none; text-transform:uppercase; letter-spacing:.14em; font-size:.58rem; font-weight:500; transition:transform .2s ease,background .2s ease,color .2s ease; }
  .outline-button:hover,.light-button:hover { transform:translateY(-2px); }
  .outline-button:hover { color:var(--paper); background:var(--navy); }
  .details { position:relative; display:grid; grid-template-columns:.85fr 1.3fr .85fr; align-items:center; min-height:240px; padding:42px 55px; color:var(--paper); }
  .details > div,.details blockquote { padding:0 34px; text-align:center; }
  .details > * + * { border-left:1px solid rgba(255,255,255,.24); }
  .dress-icons { margin:18px 0 8px; }
  .dress-icons img { width:35px; height:35px; margin:0 4px; filter:grayscale(1) brightness(2); opacity:.9; }
  .dress p:not(.section-kicker) { margin:4px 0; text-transform:uppercase; letter-spacing:.2em; font-size:.62rem; }
  .dress small { font-family:"Cormorant Garamond",serif; font-size:.82rem; }
  .swatches { display:flex; justify-content:center; gap:12px; margin-top:24px; }
  .swatches span { display:flex; flex-direction:column; align-items:center; gap:8px; }
  .swatches span::before { content:""; width:43px; height:43px; border-radius:50%; background:var(--swatch); box-shadow:inset 0 0 0 1px rgba(255,255,255,.45); }
  .swatches i { font-style:normal; text-transform:uppercase; letter-spacing:.09em; font-size:.45rem; white-space:nowrap; }
  .details blockquote { margin:0; font-family:"Cormorant Garamond",serif; font-size:1.25rem; font-style:italic; line-height:1.4; }
  .gallery-section { padding:35px 52px 42px; text-align:center; background:var(--paper); }
  .photo-strip { display:grid; grid-template-columns:repeat(5,1fr); gap:15px; max-width:920px; margin:26px auto 18px; }
  .photo-strip a { height:185px; overflow:hidden; background:#d5ced3; }
  .photo-strip img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease,filter .5s ease; }
  .photo-strip a:hover img { transform:scale(1.05); filter:saturate(.78); }
