---
import MusicPlayer from "./MusicPlayer.astro";
const { nombre = "", pases = "" } = Astro.props;
const mapUrl = "https://maps.app.goo.gl/JW7xFiGnCtgsF4QZ9?g_st=iw";
const palette = [
  ["Lavanda", "#B7A7D9"], ["Lila suave", "#DCC6E6"],
  ["Marfil", "#F7F5F0"], ["Verde salvia", "#A8B89A"],
  ["Azul empolvado", "#AEBCCE"], ["Malva", "#B78EAA"],
];
---

<main class="invitation-shell">
  <nav class="topbar" aria-label="Navegación principal">
    <a href="#inicio">Inicio</a><a href="#familias">Familias</a>
    <a class="monogram" href="#inicio" aria-label="Kamila y Angelo, inicio"><span>K</span><i>&amp;</i><span>A</span></a>
    <a href="#ceremonia">Ceremonia</a><a href="#vestimenta">Vestimenta</a>
  </nav>
  <div class="music-dock"><MusicPlayer /></div>

  <section class="hero floral" id="inicio">
    <span class="botanical b1" aria-hidden="true">❋</span><span class="botanical b2" aria-hidden="true">❋</span>
    <div class="hero-copy reveal">
      {nombre && <p class="guest-name">{nombre}</p>}
      <p class="eyebrow">Con la bendición de Dios</p>
      <h1><span>Kamila</span><em>&amp;</em><span>Angelo</span></h1>
      <div class="ornament"><span></span>✦<span></span></div>
      <p class="hero-message">Hemos elegido caminar juntos para siempre</p>
      <a class="soft-button" href="#ceremonia">Descubre nuestro día <span>↓</span></a>
    </div>
    <div class="hero-photo-wrap reveal">
      <div class="hero-photo"><img src="/main_photo.webp" alt="Una pareja compartiendo un momento especial" width="500" height="500" fetchpriority="high" /></div>
      <span class="photo-caption">Nuestro para siempre comienza aquí</span>
    </div>
  </section>

  <section class="intro section-line reveal">
    <p class="section-kicker">Nuestra boda</p>
    <h2>Hay momentos que se guardan en el corazón para siempre</h2>
    <p>Nos encantará compartir contigo la alegría, la naturaleza y el amor de este día tan especial.</p>
  </section>

  <section class="families section-line" id="familias">
    <div class="family-card reveal">
      <p class="section-kicker">La novia</p><h2>Kamila De Los Ángeles<br />Rosado Navarro</h2><div class="family-divider">❦</div>
      <p class="parents-label">Acompañada por sus padres</p><p class="parent-name">Jorge Rosado Figueroa</p><p class="parent-name">Mariana Navarro Crespin</p>
    </div>
    <div class="family-seal" aria-hidden="true"><span>K</span><i>&amp;</i><span>A</span></div>
    <div class="family-card reveal">
      <p class="section-kicker">El novio</p><h2>Angelo Steeven<br />Romero Paltan</h2><div class="family-divider">❦</div>
      <p class="parents-label">Acompañado por sus padres</p><p class="parent-name">Wilber Romero</p><p class="parent-name">Luisa Paltan Atupaña</p>
    </div>
  </section>

  <section class="ceremony section-line" id="ceremonia">
    <div class="ceremony-art reveal" aria-hidden="true"><span class="arch-line"></span><img src="/icons/church.svg" alt="" /><span class="leaf-line">❧ ❧ ❧</span></div>
    <div class="ceremony-copy reveal">
      <p class="section-kicker">Ceremonia religiosa</p><h2>Iglesia Católica<br />San Juan de la Cruz</h2>
      <p class="address">Calle 54SE Dra. Mariana Argudo<br />y Av. Domingo Comín</p>
      <a class="outline-button" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar <span>↗</span></a>
    </div>
  </section>

  <section class="dress-code section-line" id="vestimenta">
    <div class="dress-heading reveal">
      <p class="section-kicker light">Código de vestimenta</p><h2>Formal elegante</h2><p class="garden">Garden Wedding</p>
      <div class="dress-icons"><img src="/icons/dress.svg" alt="Vestido formal" /><span></span><img src="/icons/tie.svg" alt="Corbata de traje formal" /></div>
    </div>
    <div class="dress-copy reveal">
      <p>Nos encantará compartir este día tan especial rodeados de elegancia, naturaleza y amor.</p>
      <div class="dress-columns">
        <div><h3>Mujeres</h3><p>Vestidos largos o midi, o conjuntos formales en tonos lavanda, lila, verde salvia, azul empolvado o malva.</p></div>
        <div><h3>Hombres</h3><p>Traje formal o pantalón de vestir con blazer en tonos gris, azul claro o verde salvia, acompañado de accesorios en nuestra paleta.</p></div>
      </div>
    </div>
  </section>

  <section class="palette-section section-line">
    <div class="palette-copy reveal"><p class="section-kicker">Paleta sugerida</p><h2>Una celebración en armonía</h2><p>Agradecemos respetar nuestra paleta para crear una celebración romántica y llena de encanto.</p></div>
    <div class="swatches reveal" aria-label="Paleta de colores sugerida">
      {palette.map(([name, color]) => <div><span style={`--swatch:${color}`}></span><strong>{name}</strong><small>{color}</small></div>)}
    </div>
    <div class="reserved reveal"><span>Colores reservados</span><strong>Blanco · Beige · Negro · Rojo</strong></div>
  </section>

  {pases && <section class="personal-pass section-line"><span>✦</span><p>Hemos reservado</p><strong>{pases} {pases === "1" ? "lugar" : "lugares"}</strong><p>especialmente para ti.</p><small>Esta invitación es personal e intransferible.</small></section>}

  <section class="closing floral section-line"><p class="section-kicker light">Gracias por ser parte de nuestro día especial</p><h2>El amor nos unió<br />y queremos celebrarlo contigo</h2><div class="closing-monogram"><span>K</span><i>&amp;</i><span>A</span></div></section>
  <footer><a href="#inicio" aria-label="Volver arriba">↑</a><div><h2>Kamila <i>&amp;</i> Angelo</h2><p>Con amor, para siempre</p></div><span>❦</span></footer>
</main>

<script>
  const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); } }), { threshold: 0.12 });
  document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
</script>

<style>
  .invitation-shell{width:min(100%,1180px);margin:0 auto;overflow:hidden;background:var(--ivory);box-shadow:0 0 60px rgba(61,54,67,.14)}.section-line{border-top:1px solid var(--line)}
  .topbar{position:relative;z-index:20;min-height:76px;display:grid;grid-template-columns:1fr 1fr 110px 1fr 1fr;align-items:center;gap:8px;padding:0 70px;background:rgba(247,245,240,.96)}.topbar>a:not(.monogram){text-align:center;text-decoration:none;text-transform:uppercase;letter-spacing:.16em;font-size:.61rem;font-weight:500}.monogram{align-self:start;justify-self:center;width:80px;height:98px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid var(--line);border-top:0;background:var(--ivory);text-decoration:none;font-family:"Italiana",serif;font-size:1.2rem;line-height:.72;box-shadow:0 8px 22px rgba(68,58,73,.08)}.monogram i,.closing-monogram i,footer i{color:var(--mauve);font-family:"Cormorant Garamond",serif;font-size:.72em;font-weight:400}.music-dock{position:fixed;z-index:30;right:24px;bottom:24px;width:min(360px,calc(100vw - 48px))}
  .floral{position:relative;color:#fff;background:linear-gradient(135deg,#7f9275 0%,#9aa98e 46%,#8b7d9d 100%)}.floral::after{content:"";position:absolute;inset:0;opacity:.13;pointer-events:none;background:url("/og-background.webp") center/cover;mix-blend-mode:screen}.hero{min-height:640px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:58px;padding:72px 90px 62px}.hero>*{position:relative;z-index:2}.hero-copy{text-align:center}.guest-name{display:inline-block;margin:0 0 24px;padding:8px 20px;border:1px solid #ffffff88;border-radius:99px;font:italic 1.05rem "Cormorant Garamond",serif}.eyebrow,.section-kicker{margin:0;text-transform:uppercase;letter-spacing:.24em;font-size:.66rem;font-weight:500}h1{margin:18px 0 20px;font:400 clamp(3.6rem,6vw,6rem)/.9 "Italiana",serif;text-transform:uppercase}h1 span{display:block}h1 em{display:block;margin:9px 0 5px;font:400 .38em "Cormorant Garamond",serif;text-transform:none}.ornament{display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:18px;color:#efe5d7}.ornament span{width:54px;height:1px;background:currentColor}.hero-message{margin:0 auto 25px;font:italic 1.08rem "Cormorant Garamond",serif}.soft-button,.outline-button{min-height:40px;display:inline-flex;align-items:center;gap:20px;padding:9px 24px;border:1px solid;border-radius:99px;color:inherit;text-decoration:none;text-transform:uppercase;letter-spacing:.14em;font-size:.57rem;font-weight:500;transition:.2s}.soft-button:hover,.outline-button:hover{transform:translateY(-2px)}.soft-button:hover{color:#68765f;background:var(--ivory)}.hero-photo-wrap{width:min(100%,390px);justify-self:center;text-align:center}.hero-photo{height:470px;padding:13px;border:1px solid #ffffffb8;border-radius:195px 195px 8px 8px}.hero-photo img{width:100%;height:100%;display:block;object-fit:cover;border-radius:182px 182px 4px 4px;filter:saturate(.75) sepia(.08)}.photo-caption{display:block;margin-top:14px;font:italic 1rem "Cormorant Garamond",serif}.botanical{position:absolute!important;z-index:1!important;color:#ffffff2e;font-size:12rem;line-height:1}.b1{left:-4%;bottom:-4%;transform:rotate(20deg)}.b2{right:-3%;top:3%;transform:rotate(-25deg)}
  .intro{padding:68px 20px;text-align:center}.intro h2,.family-card h2,.ceremony h2,.dress-code h2,.palette-copy h2,.closing h2,footer h2{font-family:"Cormorant Garamond",serif;font-weight:500}.intro h2{max-width:680px;margin:17px auto 14px;font-size:2.7rem;line-height:1.05}.intro>p:last-child,.palette-copy>p:last-child{max-width:560px;margin:0 auto;font:1.12rem/1.65 "Cormorant Garamond",serif}
  .families{display:grid;grid-template-columns:1fr 110px 1fr;align-items:center;padding:68px 70px;background:linear-gradient(90deg,#f7f5f0,#f1ebf5 50%,#f7f5f0)}.family-card{text-align:center}.family-card h2{margin:18px 0;font-size:2rem;line-height:1.08}.family-divider{color:var(--sage);font-size:1.4rem}.parents-label{margin:14px 0 9px;text-transform:uppercase;letter-spacing:.13em;font-size:.56rem}.parent-name{margin:4px 0;font:1.12rem "Cormorant Garamond",serif}.family-seal{width:84px;height:84px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid var(--lavender);border-radius:50%;font:1rem/.65 "Italiana",serif;color:#75677f;background:var(--ivory)}.family-seal i{font-family:"Cormorant Garamond",serif;color:var(--sage-deep);font-size:.72rem}
  .ceremony{display:grid;grid-template-columns:.85fr 1.15fr;min-height:410px}.ceremony-art{position:relative;min-height:410px;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(150deg,var(--soft-lilac),#ece3ef)}.arch-line{position:absolute;width:230px;height:330px;border:1px solid #75677f57;border-radius:120px 120px 0 0}.ceremony-art img{position:relative;width:96px;height:96px;object-fit:contain}.leaf-line{position:relative;margin-top:24px;color:#788a70;letter-spacing:.5em}.ceremony-copy{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:55px;text-align:center}.ceremony-copy h2{margin:18px 0 13px;font-size:2.75rem;line-height:1.02}.address{margin:0 0 24px;font:1.05rem/1.55 "Cormorant Garamond",serif}.outline-button{color:#75677f}.outline-button:hover{color:#fff;background:#75677f}
  .dress-code{display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;min-height:460px;color:#fff;background:linear-gradient(135deg,#8a9a80,#9da990)}.dress-heading{padding:60px;text-align:center;border-right:1px solid #ffffff40}.dress-heading h2{margin:18px 0 0;font-size:3.2rem;line-height:1}.garden{margin:8px 0 24px;text-transform:uppercase;letter-spacing:.22em;font-size:.62rem}.dress-icons{display:flex;align-items:center;justify-content:center;gap:14px}.dress-icons span{width:38px;height:1px;background:#ffffff73}.dress-icons img{width:54px;height:54px;object-fit:contain}.dress-copy{padding:55px 70px}.dress-copy>p{margin:0 0 28px;font:1.25rem/1.55 "Cormorant Garamond",serif;text-align:center}.dress-columns{display:grid;grid-template-columns:1fr 1fr;gap:38px}.dress-columns h3{margin:0 0 10px;text-transform:uppercase;letter-spacing:.17em;font-size:.64rem}.dress-columns p{margin:0;font-size:.76rem;line-height:1.75}
  .palette-section{padding:64px 58px 50px;text-align:center}.palette-copy h2{margin:15px 0 10px;font-size:2.55rem}.swatches{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;max-width:850px;margin:38px auto 34px}.swatches div{display:flex;flex-direction:column;align-items:center}.swatches div>span{width:84px;height:84px;border-radius:50%;background:var(--swatch);border:5px solid #fff;box-shadow:0 5px 18px #4a404e21,inset 0 0 0 1px #463c4614}.swatches strong{margin-top:11px;text-transform:uppercase;letter-spacing:.1em;font-size:.52rem}.swatches small{margin-top:4px;color:#8a808d;font-size:.5rem}.reserved{display:inline-flex;flex-direction:column;gap:6px;padding:14px 28px;border:1px solid var(--line);border-radius:99px}.reserved span{text-transform:uppercase;letter-spacing:.16em;font-size:.5rem}.reserved strong{font:500 1rem "Cormorant Garamond",serif}
  .personal-pass{padding:34px 20px;text-align:center;background:#efe8f3}.personal-pass>span{color:var(--mauve)}.personal-pass p{display:inline;margin:0 7px;font:1.15rem "Cormorant Garamond",serif}.personal-pass strong{color:#75677f;font:500 1.55rem "Cormorant Garamond",serif}.personal-pass small{display:block;margin-top:10px;text-transform:uppercase;letter-spacing:.13em;font-size:.5rem}.closing{min-height:350px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;text-align:center}.closing>*{position:relative;z-index:2}.closing h2{margin:20px 0;font-size:3.1rem;line-height:1}.closing-monogram{width:90px;height:90px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #ffffff85;border-radius:50%;font:1rem/.65 "Italiana",serif}.closing-monogram i{color:#fff}footer{min-height:140px;display:grid;grid-template-columns:80px 1fr 80px;align-items:center;padding:28px 60px;text-align:center}footer>a{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;text-decoration:none}footer h2{margin:0 0 8px;font-family:"Italiana",serif;font-size:1.45rem;text-transform:uppercase}footer p{margin:0;text-transform:uppercase;letter-spacing:.16em;font-size:.52rem}footer>span{color:var(--sage);font-size:1.5rem}.reveal{opacity:0;transform:translateY(15px);transition:opacity .75s,transform .75s}.reveal.is-visible{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}@media(max-width:820px){.topbar{padding:0 24px}.hero{padding:62px 38px}.families{padding:58px 32px}.ceremony-copy,.dress-copy{padding:48px 35px}.swatches{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:680px){.topbar{grid-template-columns:1fr 86px 1fr;padding:0 16px}.topbar>a:not(.monogram){display:none}.topbar>a:first-child,.topbar>a:last-child{display:block}.monogram{grid-column:2;grid-row:1;width:66px;height:84px}.topbar>a:first-child{grid-column:1}.topbar>a:last-child{grid-column:3}.hero{grid-template-columns:1fr;gap:38px;padding:58px 24px 46px}.hero-photo-wrap{width:min(88vw,370px)}.hero-photo{height:410px}.botanical{font-size:8rem}.intro{padding:52px 24px}.intro h2{font-size:2.2rem}.families{grid-template-columns:1fr;padding:52px 24px;gap:30px}.family-seal{margin:auto}.ceremony,.dress-code{grid-template-columns:1fr}.ceremony-art{min-height:310px}.ceremony-copy{padding:48px 24px}.ceremony-copy h2{font-size:2.35rem}.dress-heading{padding:48px 24px;border-right:0;border-bottom:1px solid #ffffff40}.dress-copy{padding:42px 26px}.dress-columns{grid-template-columns:1fr;gap:25px}.palette-section{padding:52px 22px 44px}.swatches{gap:14px}.swatches div>span{width:70px;height:70px}.closing h2{font-size:2.45rem}.music-dock{right:12px;bottom:12px;width:calc(100vw - 24px)}}
  @media(max-width:420px){h1{font-size:3.1rem}.hero-photo{height:380px}.family-card h2{font-size:1.75rem}.dress-heading h2{font-size:2.6rem}.swatches div>span{width:61px;height:61px}.reserved{border-radius:22px}.personal-pass p{display:block}footer{grid-template-columns:50px 1fr 50px;padding:25px 12px}footer h2{font-size:1.08rem}}
</style>
