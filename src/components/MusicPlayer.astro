<section class="music-player" data-music-player aria-label="Control de música">
  <div class="music-player__copy">
    <span>Nuestra canción</span>
    <p data-music-status>A Thousand Years</p>
  </div>
  <button type="button" aria-label="Reproducir música" aria-pressed="false" data-music-toggle>
    <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"></path></svg>
    <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"></path></svg>
  </button>
  <audio data-music-audio preload="none" loop><source src="/A_Thousand_Years.mp3" type="audio/mpeg" /></audio>
</section>

<script>
  const player = document.querySelector<HTMLElement>("[data-music-player]");
  if (player) {
    const audio = player.querySelector<HTMLAudioElement>("[data-music-audio]");
    const button = player.querySelector<HTMLButtonElement>("[data-music-toggle]");
    const status = player.querySelector<HTMLElement>("[data-music-status]");
    const update = (playing: boolean) => {
      player.dataset.playing = String(playing);
      button?.setAttribute("aria-pressed", String(playing));
      button?.setAttribute("aria-label", playing ? "Pausar música" : "Reproducir música");
      if (status) status.textContent = playing ? "Reproduciendo…" : "A Thousand Years";
    };
    button?.addEventListener("click", async () => {
      if (!audio) return;
      if (audio.paused) {
        try { await audio.play(); } catch { if (status) status.textContent = "Pulsa de nuevo para reproducir"; }
      } else audio.pause();
    });
    audio?.addEventListener("play", () => update(true));
    audio?.addEventListener("pause", () => update(false));
  }
</script>

<style>
  .music-player { display:flex; align-items:center; justify-content:flex-end; gap:12px; pointer-events:none; }
  .music-player__copy { padding:9px 16px; border:1px solid rgba(255,255,255,.38); border-radius:999px; color:#fff; background:rgba(63,69,95,.88); box-shadow:0 8px 24px rgba(30,31,47,.2); text-align:right; backdrop-filter:blur(8px); opacity:0; transform:translateX(12px); transition:opacity .2s ease,transform .2s ease; }
  .music-player:hover .music-player__copy,.music-player:focus-within .music-player__copy { opacity:1; transform:none; }
  .music-player__copy span { display:block; text-transform:uppercase; letter-spacing:.13em; font-size:.47rem; }
  .music-player__copy p { margin:2px 0 0; font-family:"Cormorant Garamond",serif; font-size:.82rem; }
  button { width:50px; height:50px; display:grid; place-items:center; flex:none; border:1px solid rgba(255,255,255,.55); border-radius:50%; color:#fff; background:#5e627d; box-shadow:0 8px 24px rgba(30,31,47,.25); cursor:pointer; pointer-events:auto; transition:transform .2s ease,background .2s ease; }
  button:hover { transform:scale(1.05); background:#777393; }
  button:focus-visible { outline:3px solid #fff; outline-offset:3px; }
  svg { width:18px; height:18px; fill:currentColor; }
  .pause { display:none; }
  [data-playing="true"] .play { display:none; }
  [data-playing="true"] .pause { display:block; }
  @media(max-width:560px) { .music-player__copy { opacity:1; transform:none; } }
</style>
